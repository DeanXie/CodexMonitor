{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase-3-1-2/gate-schema.json",
  "title": "Phase 3.1.2 sanitized cross-surface Gate record",
  "type": "object",
  "additionalProperties": false,
  "required": ["gateId", "creatorSurface", "consumerSurface", "threadId", "oldTurnId", "newTurnId", "rolloutFile", "bytePositions", "tokens", "model", "lifecycle", "workspace", "producerSurface", "states", "occupiedWriterState", "protocolCalls", "readResult", "resumeResult", "sameThreadId", "sameRollout", "newTurnCreated", "tokenContinuity", "duplicateCount", "result"],
  "properties": {
    "gateId": { "type": "string", "minLength": 1 },
    "creatorSurface": { "$ref": "#/$defs/surface" },
    "consumerSurface": { "$ref": "#/$defs/surface" },
    "threadId": { "type": "string", "minLength": 1 },
    "oldTurnId": { "$ref": "#/$defs/observedString" },
    "newTurnId": { "$ref": "#/$defs/observedString" },
    "rolloutFile": { "type": "object", "additionalProperties": false, "required": ["identity", "sha256"], "properties": { "identity": { "$ref": "#/$defs/observedString" }, "sha256": { "$ref": "#/$defs/observedString" } } },
    "bytePositions": { "type": "object", "additionalProperties": false, "required": ["before", "resume", "after"], "properties": { "before": { "$ref": "#/$defs/nonNegativeOrUnknown" }, "resume": { "$ref": "#/$defs/nonNegativeOrUnknown" }, "after": { "$ref": "#/$defs/nonNegativeOrUnknown" } } },
    "tokens": { "type": "object", "additionalProperties": false, "required": ["cumulativeBefore", "cumulativeAfter", "newTurn"], "properties": { "cumulativeBefore": { "$ref": "#/$defs/nonNegativeOrUnknown" }, "cumulativeAfter": { "$ref": "#/$defs/nonNegativeOrUnknown" }, "newTurn": { "$ref": "#/$defs/nonNegativeOrUnknown" } } },
    "model": { "type": "object", "additionalProperties": false, "required": ["before", "after"], "properties": { "before": { "$ref": "#/$defs/observedString" }, "after": { "$ref": "#/$defs/observedString" } } },
    "lifecycle": { "$ref": "#/$defs/observedString" },
    "workspace": { "$ref": "#/$defs/observedString" },
    "producerSurface": { "$ref": "#/$defs/surface" },
    "states": { "type": "object", "additionalProperties": false, "required": ["threadExists", "resumable", "projectAssigned", "projectRetained", "catalogIndexed", "sidebarVisible"], "properties": { "threadExists": { "$ref": "#/$defs/observation" }, "resumable": { "$ref": "#/$defs/observation" }, "projectAssigned": { "$ref": "#/$defs/observation" }, "projectRetained": { "$ref": "#/$defs/observation" }, "catalogIndexed": { "$ref": "#/$defs/observation" }, "sidebarVisible": { "$ref": "#/$defs/observation" } } },
    "occupiedWriterState": { "$ref": "#/$defs/observation" },
    "protocolCalls": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["sequence", "surface", "phase", "method", "requestId", "outcome", "status", "errorClass", "turnCountBefore", "turnCountAfter"], "properties": { "sequence": { "type": "integer", "minimum": 1 }, "surface": { "$ref": "#/$defs/surface" }, "phase": { "type": "string", "enum": ["CREATE", "READ", "RESUME", "CONTINUE", "OBSERVE"] }, "method": { "$ref": "#/$defs/observedString" }, "requestId": { "$ref": "#/$defs/observedString" }, "outcome": { "$ref": "#/$defs/result" }, "status": { "$ref": "#/$defs/observedString" }, "errorClass": { "$ref": "#/$defs/observedString" }, "turnCountBefore": { "$ref": "#/$defs/nonNegativeOrUnknown" }, "turnCountAfter": { "$ref": "#/$defs/nonNegativeOrUnknown" } } } },
    "readResult": { "$ref": "#/$defs/result" },
    "resumeResult": { "$ref": "#/$defs/result" },
    "sameThreadId": { "$ref": "#/$defs/result" },
    "sameRollout": { "$ref": "#/$defs/result" },
    "newTurnCreated": { "$ref": "#/$defs/result" },
    "tokenContinuity": { "$ref": "#/$defs/result" },
    "duplicateCount": { "$ref": "#/$defs/nonNegativeOrUnknown" },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "surface": { "type": "string", "enum": ["CLI", "DESKTOP", "MONITOR", "REMOTE", "UNKNOWN", "NOT_OBSERVED"] },
    "observedString": { "type": "string", "minLength": 1 },
    "nonNegativeOrUnknown": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "enum": ["UNKNOWN", "NOT_OBSERVED"] }] },
    "observation": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "UNKNOWN", "NOT_OBSERVED"] },
    "result": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "UNKNOWN", "NOT_OBSERVED"] }
  }
}
